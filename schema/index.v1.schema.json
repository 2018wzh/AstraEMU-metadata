{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetadataIndex",
  "type": "object",
  "required": [
    "files",
    "generated_at_unix_ms",
    "schema",
    "source_commit"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/IndexedFile"
      }
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "format": "int64",
      "minimum": 0.0
    },
    "schema": {
      "type": "string",
      "pattern": "^astra\\.emu\\.metadata\\.index\\.v1$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "IndexedFile": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!index\\.json$)(?!.*\\.\\.)[a-z0-9._-]+(/[a-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "maximum": 8388608.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
